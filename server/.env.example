# Copy to server/.env (untracked) for local development and fill in real values.
# In production these go in /etc/oncotrace/env instead (see deploy/DEPLOY.md).
# Anything set in the real environment -- systemd Environment=, a shell
# export -- takes precedence over this file.
#
# Every setting the backend reads is listed below with its default
# (app/core/config.py is the source of truth). Only the two demo-credential
# keys are required.

# ---- Demo access (REQUIRED) -------------------------------------------------
# Shared credential for the invite-only liquid-biopsy demo, sent by the
# browser as HTTP Basic auth. Without a usable pair, /api/v1/auth/verify and
# /api/v1/vcf/analyze refuse every request with 503. The password is also
# refused (same 503) while it is still the placeholder below or shorter than
# 12 characters. Put the real values in server/.env or /etc/oncotrace/env,
# never here and never in client/.env (client/.env is committed and ships to
# the browser).
ONCOTRACE_DEMO_USERNAME=demo-user
ONCOTRACE_DEMO_PASSWORD=change-me

# ---- Browser access ---------------------------------------------------------
# Comma-separated origins allowed to call the API cross-origin (CORS).
# Unset: the Vite dev-server origins (localhost/127.0.0.1, ports 5173-5175).
# Set but empty: no CORS at all -- what production uses, since the site and
# the API share one origin (deploy/oncotrace-backend.service sets it empty).
# ONCOTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Serve Swagger UI and the OpenAPI schema at /docs, /redoc, /openapi.json.
# Default false; handy locally, never needed in production.
# ONCOTRACE_API_DOCS=true

# ---- Limits -----------------------------------------------------------------
# Upload cap in bytes (default 524288000 = 500 MB). Must match what the
# frontend advertises and nginx's client_max_body_size.
# ONCOTRACE_MAX_UPLOAD_BYTES=524288000

# Most a gzip/bgzip upload may expand to, in bytes (default 2147483648 =
# 2 GiB, 4x the upload cap). Stops a decompression bomb; over it -> 413.
# ONCOTRACE_MAX_DECOMPRESSED_BYTES=2147483648

# Most variant records (VCF lines or table rows) accepted per file (default
# 20000). Bounds a request's memory and response size; over it -> 413.
# ONCOTRACE_MAX_RECORDS=20000

# Analyses run at once per uvicorn worker (default 1). Each runs SnpEff with a
# 4 GB heap: keep workers x this x 4 GB under host RAM. Extra uploads get 503.
# ONCOTRACE_MAX_CONCURRENT_ANALYSES=1

# Seconds that ALL external tools of one analysis (bcftools, bgzip, tabix,
# SnpEff) may take between them (default 240). Keep it under nginx's 300s
# proxy_read_timeout; when it runs out the request fails with an incident id.
# ONCOTRACE_TOOL_BUDGET_SECONDS=240

# ---- Pipeline behaviour -----------------------------------------------------
# Human-readable panel name shown in the dashboard header (default: none).
ONCOTRACE_PANEL_NAME=Targeted Oncology Panel (GeneMind SURFSeq5000)

# true (default): VCFs from unrecognized callers are read through VCF-standard
# fields only, and marked unvalidated. false: such files are rejected (400).
# ONCOTRACE_ALLOW_GENERIC_CALLER=true

# ---- Reference data locations -----------------------------------------------
# Provisioned by scripts/download_references.sh. Every file below defaults to
# the path shown under ONCOTRACE_RESOURCES (default: server/resources), written
# here as <resources>/...; override one with an absolute path only if it lives
# elsewhere (these files do not expand variables).
# ONCOTRACE_RESOURCES=/data/oncotrace-refs
#
# SnpEff jar, its data directory, and the genome database per build:
# ONCOTRACE_SNPEFF_JAR=<resources>/snpeff/snpEff.jar
# ONCOTRACE_SNPEFF_DATA=<resources>/snpeff/data
# ONCOTRACE_SNPEFF_DB_GRCH37=GRCh37.75
# ONCOTRACE_SNPEFF_DB_GRCH38=GRCh38.105
#
# ClinVar VCFs (each needs its .tbi alongside) and the release note shown in
# responses:
# ONCOTRACE_CLINVAR_GRCH37=<resources>/clinvar/clinvar_GRCh37.vcf.gz
# ONCOTRACE_CLINVAR_GRCH38=<resources>/clinvar/clinvar_GRCh38.vcf.gz
# ONCOTRACE_CLINVAR_RELEASE=<resources>/clinvar/RELEASE.txt
#
# Reference FASTAs for bcftools norm (each needs its .fai alongside):
# ONCOTRACE_REF_GRCH37=<resources>/reference/GRCh37.fa
# ONCOTRACE_REF_GRCH38=<resources>/reference/GRCh38.fa
#
# Cached CIViC evidence and its release note:
# ONCOTRACE_CIVIC_CACHE=<resources>/civic/civic_evidence.tsv
# ONCOTRACE_CIVIC_RELEASE=<resources>/civic/RELEASE.txt
#
# Server-side panel BED (exact panel footprint), and the gene-coordinate BEDs
# used to estimate a footprint when no panel BED is available:
# ONCOTRACE_PANEL_BED=<resources>/panel/panel.bed
# ONCOTRACE_GENE_SPANS_GRCH37=<resources>/panel/gene_spans_GRCh37.bed
# ONCOTRACE_GENE_SPANS_GRCH38=<resources>/panel/gene_spans_GRCh38.bed
